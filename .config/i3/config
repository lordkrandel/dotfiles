# --------------------------------
#
#              i3
#
# --------------------------------

# Base config
font pango: Bahnschrift Light 13
workspace_layout default
set $mod Mod4
floating_modifier $mod

# Colors
set $violet #550055
set $yellow #ffff77


# Workspaces
set $ws1 "1: web "
set $ws2 "2: chat "
set $ws3 "3: mail "
set $ws4 "4: term "
set $ws5 "5: notes "
set $ws6 "6: files "
set $ws7 "7: pass "
set $ws8 "8: gimp "
set $ws9 "9: steam "

# Assign to workspace
assign [class="(?i)librewolf-discord"]              $ws2
assign [class="(?i)librewolf"]                      $ws1
assign [class="(?i)Spotify"]                        $ws2
assign [class="(?i)Thunderbird"]                    $ws3
assign [title="(?i)vifm"]                           $ws6
assign [class="(?i)st"]                             $ws4
assign [class="(?i)upnote"]                         $ws5
assign [class="(?i)Thunar"]                         $ws6
assign [class="(?i)keepassxc"]                      $ws7
assign [class="(?i)gimp"]                           $ws8
assign [class="(?i)steam"]                          $ws9
assign [title="(?i)VirtualCottage2"]                $ws9

set $float_center floating enable, move position center, focus
for_window [class="(?i)blueman-manager"]  $float_center
for_window [class="(?i)float-calendar"]   $float_center
for_window [class="(?i)pavucontrol"]      $float_center
# Drag drop from command-line script
for_window [class="(?i)dragout"]          $float_center
for_window [class="(?i)dragout"]          sticky enable

for_window [class="(?i)steam"]            move to workspace $ws9


# Taskbar
bar {
    font pango:Luxurious Script 34
    position bottom
    height 60
    tray_output primary
    strip_workspace_numbers yes
    status_command i3blocks -c ~/.config/i3/i3blocks.conf
    colors {
        background          $violet
        statusline          $white
        inactive_workspace  $violet  $violet  $grey    $purple
        urgent_workspace    $violet  $violet  $yellow  $purple
    }
}

mode "resize" {
    bindsym h       resize grow   width  5 px or 1 ppt
    bindsym l       resize shrink width  5 px or 1 ppt
    bindsym j       resize grow   height 5 px or 1 ppt
    bindsym k       resize shrink height 5 px or 1 ppt
    bindsym Left    resize grow   width  5 px or 1 ppt
    bindsym Right   resize shrink width  5 px or 1 ppt
    bindsym Down    resize shrink height 5 px or 1 ppt
    bindsym Up      resize grow   height 5 px or 1 ppt
    bindsym Return  mode "default"
    bindsym Escape  mode "default"
}

# Colors
set $darkbluetrans  #08052b
set $darkblue       #08052b
set $lightblue      #5294e2
set $urgentred      #e53935
set $white          #ffffff
set $black          #000000
set $purple         #e345ff
set $darkgrey       #383c4a
set $grey           #b0b5bd
set $mediumgrey     #8b8b8b
set $yellowbrown    #e1b700

#class                   border      bground     text     indicator     child_border
client.focused           $black      $darkblue   $white   $mediumgrey   $black
client.unfocused         $black      $darkblue   $grey    $darkgrey     $black
client.focused_inactive  $black      $darkblue   $grey    $black        $black
client.urgent            $urgentred  $urgentred  $white   $yellowbrown  $black

# Workspace keys
bindsym $mod+1                    workspace $ws1
bindsym $mod+2                    workspace $ws2
bindsym $mod+3                    workspace $ws3
bindsym $mod+4                    workspace $ws4
bindsym $mod+5                    workspace $ws5
bindsym $mod+6                    workspace $ws6
bindsym $mod+7                    workspace $ws7
bindsym $mod+8                    workspace $ws8
bindsym $mod+9                    workspace $ws9
bindsym $mod+0                    workspace $ws10
bindsym $mod+Shift+1              move container to workspace $ws1
bindsym $mod+Shift+2              move container to workspace $ws2
bindsym $mod+Shift+3              move container to workspace $ws3
bindsym $mod+Shift+4              move container to workspace $ws4
bindsym $mod+Shift+5              move container to workspace $ws5
bindsym $mod+Shift+6              move container to workspace $ws6
bindsym $mod+Shift+7              move container to workspace $ws7
bindsym $mod+Shift+8              move container to workspace $ws8
bindsym $mod+Shift+9              move container to workspace $ws9
bindsym $mod+Shift+0              move container to workspace $ws10
bindsym $mod+Left                 focus left
bindsym $mod+Down                 focus down
bindsym $mod+Up                   focus up
bindsym $mod+Right                focus right
bindsym $mod+Shift+Left           move left
bindsym $mod+Shift+Down           move down
bindsym $mod+Shift+Up             move up
bindsym $mod+Shift+Right          move right
bindsym $mod+f                    fullscreen toggle
bindsym $mod+s                    layout stacking
bindsym $mod+g                    layout tabbed
bindsym $mod+e                    layout toggle split
bindsym $mod+Shift+space          floating toggle
bindsym $mod+space                focus mode_toggle

# i3 Keys
bindsym $mod+Shift+w              kill
bindsym $mod+Shift+c              reload
bindsym $mod+Shift+r              restart
bindsym $mod+r                    mode "resize"

# Custom Keys
bindsym Print                     exec scrot ~/images/%Y%m%d_%H%M%S_screenshot.png -e 'gimp $f'
bindsym $mod+p                    exec ~/projects/scripts/snippet.py
bindsym $mod+l                    exec ~/projects/scripts/lock.sh
bindsym $mod+d                    exec ~/projects/scripts/runner.nim --center -theme ~/projects/scripts/rofi_choice_runner.rasi
bindsym $mod+Shift+p              exec ~/projects/scripts/power_profiles.sh
bindsym $mod+q                    exec ~/projects/scripts/power_menu.sh
bindsym $mod+Shift+e              exec ~/projects/offmoji/offmoji.sh

# System keys
bindsym XF86MonBrightnessUp       exec brightnessctl set "10%+" && pkill -RTMIN+10 i3blocks
bindsym XF86MonBrightnessDown     exec brightnessctl set "10%-" && pkill -RTMIN+10 i3blocks
bindsym XF86AudioLowerVolume      exec ~/projects/scripts/volume.sh -10% && pkill -RTMIN+1 i3blocks
bindsym XF86AudioRaiseVolume      exec ~/projects/scripts/volume.sh +10% && pkill -RTMIN+1 i3blocks
bindsym XF86AudioMute             exec ~/projects/scripts/mute.nim && pkill -RTMIN+1 i3blocks
bindsym XF86AudioPlay             exec playerctl play
bindsym XF86AudioPause            exec playerctl pause
bindsym XF86AudioNext             exec playerctl next
bindsym XF86AudioPrev             exec playerctl previous

# Startup
exec --no-startup-id ~/projects/scripts/startup.sh
